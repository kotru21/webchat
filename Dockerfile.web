# Multi-stage SPA image: Vite build → nginx with CSP + reverse proxy to API.
# syntax=docker/dockerfile:1

FROM node:26-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js jsconfig.json tailwind.config.js ./
COPY public ./public
COPY src ./src
# Same-origin behind the reverse proxy — leave VITE_API_URL unset.
RUN npm run build

# Pinned manifest digest for nginx:1.31.3-alpine (multi-arch).
FROM nginx:1.31.5-alpine@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
